rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Entity Validation Blueprint: Book ---
    function isValidBook(data) {
      return data.keys().hasAll(['titre', 'auteur', 'ownerId', 'createdAt'])
        && data.keys().hasOnly(['titre', 'auteur', 'annee', 'ownerId', 'createdAt'])
        && data.titre is string
        && data.titre.size() >= 1
        && data.titre.size() <= 200
        && data.auteur is string
        && data.auteur.size() >= 1
        && data.auteur.size() <= 150
        && (!('annee' in data) || (data.annee is int && data.annee >= 0 && data.annee <= 2100))
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.createdAt is timestamp;
    }

    // --- Collection Rules: /books/{bookId} ---
    match /books/{bookId} {
      allow get: if isSignedIn()
        && isValidId(bookId)
        && existing().ownerId == request.auth.uid;

      allow list: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;

      allow create: if isEmailVerified()
        && isValidId(bookId)
        && isValidBook(incoming())
        && incoming().createdAt == request.time;

      allow update: if isEmailVerified()
        && isValidId(bookId)
        && existing().ownerId == request.auth.uid
        && isValidBook(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['titre', 'auteur', 'annee']);

      allow delete: if isEmailVerified()
        && isValidId(bookId)
        && existing().ownerId == request.auth.uid;
    }
  }
}
